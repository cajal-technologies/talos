/-!
# Operational work of generated byte-vector reserve

The reserve path includes the concrete grow wrapper, allocation or reallocation,
result-slot writes, vector-header replacement, and stack-pointer restoration.
-/

namespace Project.Mergesort.ReserveCost

open Wasm Wasm.SmallStep Project.Mergesort.Representations
open Project.Mergesort.Func0Proof

private def blockAt (program : Program) (i : Nat) : Program :=
  match program[i]? with
  | some (.block _ _ body) => body
  | _ => []

private def outer := func0OuterBody
private def middle := blockAt outer 2
private def choose := blockAt middle 0
private def allocate := blockAt choose 0
private def reallocate := blockAt allocate 0
private def nonzero := blockAt allocate 1

private def frame (body continuation : Program) : ControlFrame :=
  { kind := .block, paramArity := 0, resultArity := 0,
    body, continuation, belowStack := [] }

private def outerFrame := frame outer func0FinalCode
private def middleFrame := frame middle (outer.drop 3)
private def chooseFrame := frame choose (middle.drop 1)
private def allocateFrame := frame allocate (choose.drop 1)
private def reallocateFrame := frame reallocate (allocate.drop 1)

private def growLocals (result oldCapacity oldPtr newCapacity status temp : UInt32)
    (product : UInt64) (values : List Value := []) : Locals :=
  ⟨[.i32 result, .i32 oldCapacity, .i32 oldPtr, .i32 newCapacity, .i32 1, .i32 1],
    [.i32 status, .i32 temp, .i64 product], values⟩

private def callerFrame (store : MachineStore α) (caller : ThreadState α) : CallFrame :=
  { locals := caller.locals, continuation := caller.code, resultArity := caller.resultArity,
    callerRemainder := caller.callerRemainder, control := caller.control,
    returningInstance := store.runtime.entry }

def growCall (store : MachineStore α) (result oldCapacity oldPtr newCapacity : UInt32)
    (caller : ThreadState α) : Config α :=
  ⟨.running { caller with
    locals := { caller.locals with values := [.i32 1, .i32 1, .i32 newCapacity, .i32 oldPtr, .i32 oldCapacity, .i32 result] ++ caller.locals.values }
    code := .call 3 :: caller.code }, store⟩

private def growPrefixTrace : List StepKind :=
  [.call 3, .const 1, .localSet 6, .const 4, .localSet 7,
    .block 0 0 outer, .block 0 0 (blockAt outer 0),
    .localGet 5, .extendUI32, .localGet 3, .extendUI32, .mulI64,
    .localTee 8, .constI64 32, .shrUI64, .wrapI64, .eqz, .br_if 0,
    .block 0 0 (blockAt outer 1), .localGet 8, .wrapI64, .localTee 3,
    .const 2147483648, .localGet 4, .sub, .leU, .br_if 0,
    .block 0 0 middle, .block 0 0 choose, .block 0 0 allocate,
    .block 0 0 reallocate].map StepKind.instruction

private theorem grow_prefix (store : MachineStore α)
    (result oldCapacity oldPtr newCapacity : UInt32) (caller : ThreadState α)
    (hmodule : store.runtime.currentModule = Project.Mergesort.module)
    (hnew : newCapacity.toNat ≤ 2147483647)
    (hostBytes : Config α → Nat → Config α → Nat) :
    ∃ trace, trace.length = 31 ∧ CostedSteps (byteWork hostBytes)
      (growCall store result oldCapacity oldPtr newCapacity caller) trace
      ⟨.running ⟨growLocals result oldCapacity oldPtr newCapacity 1 4 newCapacity.toUInt64,
        reallocate, 0, [],
        [reallocateFrame, allocateFrame, chooseFrame, middleFrame, outerFrame],
        callerFrame store caller :: caller.calls⟩, store⟩ trace.length := by
  have hhigh : UInt64.ofNat newCapacity.toNat >>> (32 : UInt64) = 0 := by
    apply UInt64.toNat.inj
    rw [UInt64.toNat_shiftRight]
    rw [show (32 : UInt64).toNat % 64 = 32 by decide]
    norm_num [Nat.shiftRight_eq_div_pow]
    have hw := newCapacity.toBitVec.isLt
    omega
  have hguard : newCapacity ≤ (2147483648 : UInt32) - 1 := by
    rw [UInt32.le_iff_toNat_le_toNat]
    exact hnew
  refine ⟨growPrefixTrace, rfl, ?_⟩
  apply Steps.with_unit_cost
  · unfold growCall growPrefixTrace
    apply Steps.cons (Step.call (fn := func0Def)
      (by rw [hmodule]; decide) (by rw [hmodule]; rfl))
    simp only [func0Def, func0, Function.toLocals, Function.numParams]
    wasm_steps [.const, (.localSet rfl), .const, (.localSet rfl), .block, .block,
      (.localGet rfl), .extendUI32, (.localGet rfl), .extendUI32, .mulI64]
    simp only [extendUnsigned32To64_eq, UInt32.toNat_one, UInt64.ofNat_one, UInt64.one_mul]
    wasm_steps [(.localTee rfl), .constI64, .shrUI64]
    rw [show (32 : UInt64) % 64 = 32 by decide, hhigh]
    wasm_steps [.wrapI64, (.eqz (result := 1) (by decide)), (.brIf (by decide) rfl),
      .block, (.localGet rfl), .wrapI64]
    rw [wrap64To32_eq]
    simp only [UInt64.ofNat_uInt32ToNat, UInt32.toNat_toUInt64, UInt32.ofNat_mod_size, UInt32.ofNat_toNat]
    wasm_steps [(.localTee rfl), .const, (.localGet rfl), .sub,
      (.leU (result := 1) (by rw [if_pos hguard])), (.brIf (by decide) rfl),
      .block, .block, .block, .block]
    exact Steps.refl _
  · intro before kind after member
    fin_cases member <;> rfl

/-- Exact successful grow-result writeback: pointer, capacity, then tag zero. -/
def growResultStore (store : MachineStore α) (result base newCapacity : UInt32) : MachineStore α :=
  { store with wasm := { store.wasm with mem :=
      ((store.wasm.mem.write32 (result + 4) base).write32 (result + 8) newCapacity).write32 result 0 } }

private def successTrace : List StepKind :=
  [.instruction (.localGet 7), .instruction (.br_if 0),
    .instruction (.localGet 0), .instruction (.localGet 7), .instruction (.store32 4),
    .instruction (.const 0), .instruction (.localSet 6), .administrative .exitControl,
    .instruction (.const 8), .instruction (.localSet 7), .administrative .exitControl] ++
    func0FinalCode.map StepKind.instruction ++ [.administrative .returnFromCall]

private theorem grow_success (store : MachineStore α)
    (result oldCapacity oldPtr newCapacity base : UInt32) (caller : ThreadState α)
    (hbase : base ≠ 0) (hresultWord : result.toNat + 12 < UInt32.size)
    (hresult : result.toNat + 12 ≤ store.wasm.mem.pages * 65536)
    (hostBytes : Config α → Nat → Config α → Nat) :
    CostedSteps (byteWork hostBytes)
      ⟨.running ⟨growLocals result oldCapacity oldPtr newCapacity 1 base newCapacity.toUInt64,
        choose.drop 1, 0, [], [chooseFrame, middleFrame, outerFrame],
        callerFrame store caller :: caller.calls⟩, store⟩ successTrace
      ⟨.running caller, growResultStore store result base newCapacity⟩ 20 := by
  have hresult8 : (result + 8).toNat = result.toNat + 8 := by
    simpa using byteOffset_toNat result 8 (by omega)
  have execution : Steps
      ⟨.running ⟨growLocals result oldCapacity oldPtr newCapacity 1 base newCapacity.toUInt64,
        choose.drop 1, 0, [], [chooseFrame, middleFrame, outerFrame],
        callerFrame store caller :: caller.calls⟩, store⟩ successTrace
      ⟨.running caller, growResultStore store result base newCapacity⟩ := by
    unfold successTrace
    wasm_steps [(.localGet rfl), (.brIf hbase rfl), (.localGet rfl), (.localGet rfl)]
    apply Steps.cons (Step.store32 (logicalAddress := result.toNat) (physicalAddress := result)
      rfl (by change result.toNat + 4 + 4 ≤ store.wasm.mem.pages * 65536; omega))
    simp only [setMemory_eq]
    wasm_steps [.const, (.localSet rfl), (.exitControl rfl), .const, (.localSet rfl),
      (.exitControl rfl), (.localGet rfl), (.localGet rfl), .add]
    rw [UInt32.add_comm (8 : UInt32) result]
    wasm_steps [(.localGet rfl)]
    apply Steps.cons (Step.store32 (logicalAddress := (result + 8).toNat) (physicalAddress := result + 8)
      rfl (by change (result + 8).toNat + 0 + 4 ≤ store.wasm.mem.pages * 65536; rw [hresult8]; omega))
    simp only [setMemory_eq, UInt32.add_zero]
    wasm_steps [(.localGet rfl), (.localGet rfl)]
    apply Steps.cons (Step.store32 (logicalAddress := result.toNat) (physicalAddress := result)
      rfl (by change result.toNat + 0 + 4 ≤ store.wasm.mem.pages * 65536; omega))
    simp only [setMemory_eq, UInt32.add_zero]
    exact Steps.single (Step.returnFromCallFallthrough rfl)
  exact execution.with_unit_cost (by
    intro before kind after member
    fin_cases member <;> rfl)

